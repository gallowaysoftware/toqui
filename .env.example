# Toqui self-host config. Copy this to `.env` and fill in.
# `docker compose up` reads `.env` automatically.

# ── Required ────────────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── AI provider — at least one is required ─────────────────────────────────
# AI_PROVIDER picks the primary: gemini (default) | claude | openai.
# Using an OpenAI/OpenAI-compatible endpoint? ALWAYS set AI_PROVIDER=openai
# explicitly — auto-selection can be defeated by stray Google credentials
# (e.g. the managed-Firestore setup mounts a service-account key).
# AI_PROVIDER=

# Gemini Developer API (default primary). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (Ollama, llama-swap, vLLM,
# LM Studio, OpenRouter, Together, etc.). For non-OpenAI endpoints set
# OPENAI_BASE_URL, set AI_PROVIDER=openai, and use any non-empty value as
# OPENAI_API_KEY if your server doesn't check keys.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # local Ollama / llama-swap
# Map the three model tiers to models your endpoint actually serves
# (defaults are gpt-4o-mini / gpt-4o / gpt-4o). llama-swap routes requests
# by this model name, so these choose which local model handles each tier.
# OPENAI_MODEL_FAST=qwen3-8b
# OPENAI_MODEL_SMART=qwen3-32b
# OPENAI_MODEL_BEST=qwen3-32b

# Gemini via Vertex AI instead of the Developer API. Requires a GCP project
# with Vertex enabled + Application Default Credentials mounted into the
# container. Skip this if you set GEMINI_API_KEY above.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# Per-tier model overrides for Gemini / Claude (rarely needed):
# AI_GEMINI_MODEL_FAST= / AI_GEMINI_MODEL_SMART= / AI_GEMINI_MODEL_BEST=
# AI_MODEL_FAST= / AI_MODEL_SMART= / AI_MODEL_BEST=

# ── Security ────────────────────────────────────────────────────────────────
# Comma-separated email domains allowed to register (e.g. example.com).
# Empty = anyone who can reach the backend can create an account and chat
# on your AI key. Strongly recommended for internet-facing deploys.
ALLOWED_EMAIL_DOMAINS=

# ── Optional: Google OAuth ──────────────────────────────────────────────────
# Leave unset to disable Google sign-in (the frontend will only show
# email + password). To enable, create an OAuth client at
# https://console.cloud.google.com/apis/credentials and set:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Optional: URLs ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:8090

# ── Optional: Postgres credentials override ─────────────────────────────────
# Alphanumeric only — the password is spliced into a postgres:// URL, so
# URL-reserved characters (@ : / ? #) and $ will break DATABASE_URL.
# POSTGRES_PASSWORD=toqui
