default_platform(:ios)

# Fastlane config lives at the repo ROOT (this dir), and the lanes use
# ios/-relative paths, so run fastlane FROM THE REPO ROOT — e.g. `fastlane beta`,
# not `cd ios && fastlane beta`.
#
# The native project is generated by Expo, so before any lane run:
#   npx expo prebuild --platform ios --clean && (cd ios && pod install)
# (scripts/ios-testflight.sh does this end-to-end.)

platform :ios do
  # Returns an App Store Connect API key when ASC_KEY_ID/ISSUER_ID/P8_PATH are
  # all set (non-interactive upload, e.g. over SSH), else nil so Fastlane falls
  # back to interactive Apple ID auth using the Appfile's apple_id.
  private_lane :asc_api_key do
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_KEY_P8_PATH"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_P8_PATH"],
      )
    end
  end

  # gym args for Xcode automatic ("managed") signing. `expo prebuild --clean`
  # regenerates the pbxproj without a team, so the team is injected here at
  # build time instead of being persisted in the Xcode project.
  # -allowProvisioningUpdates lets xcodebuild create/refresh the profile (using
  # the Apple ID signed into Xcode, or the ASC API key when provided).
  private_lane :signing_xcargs do
    args = "-allowProvisioningUpdates"
    args += " DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}" if ENV["APPLE_TEAM_ID"]
    args
  end

  desc "Build the app for the simulator (debug, no signing)"
  lane :build_sim do
    build_ios_app(
      workspace: "ios/Toqui.xcworkspace",
      scheme: "Toqui",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      derived_data_path: "ios/build",
      build_path: "ios/build",
      skip_archive: true,
      skip_codesigning: true,
    )
  end

  desc "Build a Release archive and upload it to TestFlight."
  desc "Build number comes from app.json (scripts/ios-testflight.sh bumps it);"
  desc "signing is Xcode automatic (set APPLE_TEAM_ID + be signed into Xcode,"
  desc "or provide an ASC API key). Run from the repo root after expo prebuild."
  lane :beta do
    # Capture the key ONCE so the same auth drives both provisioning updates
    # during signing/export and the TestFlight upload. Passing it to
    # build_ios_app is what makes automatic signing work non-interactively
    # (xcodebuild gets -authenticationKeyID/-IssuerID/-KeyPath); without it the
    # archive can only sign via the Xcode GUI keychain session.
    key = asc_api_key
    build_ios_app(
      workspace: "ios/Toqui.xcworkspace",
      scheme: "Toqui",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "Toqui.ipa",
      api_key: key,
      xcargs: signing_xcargs,          # archive phase
      export_xcargs: signing_xcargs,   # export phase (separate xcodebuild call)
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"],
      }.compact,
    )
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit to App Store for review"
  lane :release do
    key = asc_api_key
    build_ios_app(
      workspace: "ios/Toqui.xcworkspace",
      scheme: "Toqui",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "Toqui.ipa",
      api_key: key,
      xcargs: signing_xcargs,
      export_xcargs: signing_xcargs,
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"],
      }.compact,
    )
    # Uploads the binary only. The listing (name, description, screenshots) is
    # managed by hand in App Store Connect — there's no fastlane/metadata dir,
    # so skip_metadata avoids deliver erroring on an empty metadata push.
    upload_to_app_store(
      api_key: key,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
    )
  end
end
